{
  "name": "@skyvern/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "echo 'No tests yet'",
    "test:e2e": "bash ./scripts/test-e2e.sh",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "dotenv -e ../../.env -- prisma db seed --schema prisma/schema.prisma",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "acceptance:block5": "bash ./scripts/acceptance-block5.sh",
    "acceptance:block6": "bash ./scripts/acceptance-block6.sh",
    "acceptance:block7": "bash ./scripts/acceptance-block7.sh",
    "acceptance:block8": "bash ./scripts/acceptance-block8.sh"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "6.19.2",
    "@skyvern/shared": "workspace:*",
    "argon2": "^0.44.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.2",
    "tsx": "^4.19.1"
  }
}
